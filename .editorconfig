# EditorConfig — unifica el estilo de indentación del proyecto SWGEC
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Backend Java: solo espacios, 4 de indentación
[*.java]
indent_style = space
indent_size = 4

# Frontend estático
[*.{js,css,html}]
indent_style = space
indent_size = 2

# Configuración
[*.{yml,yaml,properties,xml}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
