# Marca el código generado por Lombok con @lombok.Generated.
# JaCoCo excluye automáticamente los métodos anotados así, de modo que la
# cobertura mide la lógica escrita a mano y no los getters/setters/builders.
lombok.addLombokGeneratedAnnotation = true

# Evita que Lombok busque configuraciones en carpetas superiores al proyecto.
config.stopBubbling = true
